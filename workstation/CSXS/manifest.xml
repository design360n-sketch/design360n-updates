<?xml version="1.0" encoding="UTF-8"?>
<ExtensionManifest Version="7.0"
                   ExtensionBundleId="com.design360n.workstation"
                   ExtensionBundleVersion="17.7.23"
                   ExtensionBundleName="Design360n Workstation"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <ExtensionList>
    <Extension Id="com.design360n.workstation.panel" Version="17.7.23" />
  </ExtensionList>

  <ExecutionEnvironment>
    <HostList>
      <!-- Supports Adobe Illustrator CC 2019 (23.0) through 2026+ -->
      <Host Name="ILST" Version="[23.0,99.9]" />
    </HostList>
    <LocaleList>
      <Locale Code="All" />
    </LocaleList>
    <RequiredRuntimeList>
      <RequiredRuntime Name="CSXS" Version="9.0" />
    </RequiredRuntimeList>
  </ExecutionEnvironment>

  <DispatchInfoList>
    <Extension Id="com.design360n.workstation.panel">
      <DispatchInfo>
        <Resources>
          <MainPath>./client/index.html</MainPath>
          <ScriptPath>./host/index.jsx</ScriptPath>
          <CEFCommandLine>
            <Parameter>--enable-nodejs</Parameter>
            <Parameter>--mixed-context</Parameter>
          </CEFCommandLine>
        </Resources>
        <Lifecycle>
          <AutoVisible>true</AutoVisible>
        </Lifecycle>
        <UI>
          <Type>Panel</Type>
          <Menu>Design360n Workstation</Menu>
          <Geometry>
            <Size>
              <Height>780</Height>
              <Width>470</Width>
            </Size>
            <MinSize>
              <Height>540</Height>
              <Width>370</Width>
            </MinSize>
            <MaxSize>
              <Height>1400</Height>
              <Width>1400</Width>
            </MaxSize>
          </Geometry>
        </UI>
      </DispatchInfo>
    </Extension>
  </DispatchInfoList>
</ExtensionManifest>
